---
interface Props {
    activePage?: string;
    isGuest?: boolean;
}
const { activePage, isGuest = false } = Astro.props;
---
<header class="header">
    <div class="container">
        <div class="header-flex">
            <a class="logo" href="/"><img src="/img/logo.png" alt=""></a>
            {
                !isGuest && (
                    <div class="header-menu--wrap">
                        <ul class="header-menu">
                            <li><a class={activePage === 'cabinet' ? 'active' : ''} href="/cabinet">Упражнения</a></li>
                            <li><a class={activePage === 'videos' ? 'active' : ''} href="/videos">Видео-карточки</a></li>
                            <li><a class={activePage === 'blog' ? 'active' : ''} href="/blog">Статьи</a></li>
                        </ul>
                    </div>
                )
            }
            <div class="header-btns">
                {
                    isGuest ? (
                        <>
                            <a class="btn btn-white modal-trigger" href="/" data-modal="modalLogin">Вход</a>
                            <a class="btn btn-orange modal-trigger" href="/site/register" data-modal="modalRegistration">Регистрация</a>
                        </>
                    ) : (
                        <>
                            <a href="/checkout" class="btn btn-blue get-pro">
                                Оформить подписку
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                                    <path d="M6.48374 0.69121C6.7831 -0.230101 8.0865 -0.2301 8.38586 0.691211L9.45543 3.98301C9.5893 4.39503 9.97326 4.67399 10.4065 4.67399H13.8677C14.8364 4.67399 15.2392 5.91361 14.4555 6.48301L11.6553 8.51745C11.3048 8.77209 11.1582 9.22346 11.292 9.63548L12.3616 12.9273C12.6609 13.8486 11.6065 14.6147 10.8228 14.0453L8.02258 12.0109C7.6721 11.7562 7.1975 11.7562 6.84701 12.0109L4.04684 14.0453C3.26313 14.6147 2.20865 13.8486 2.508 12.9273L3.57757 9.63548C3.71145 9.22346 3.56479 8.77209 3.2143 8.51745L0.414132 6.48301C-0.369582 5.91361 0.0331941 4.67399 1.00192 4.67399H4.46312C4.89634 4.67399 5.2803 4.39503 5.41417 3.98301L6.48374 0.69121Z" fill="#FFC107"></path>
                                </svg>
                            </a>
                            <a class="btn btn-white btn-logout" href="/" data-directus-logout>Выход</a>
                            <a href="/cabinet" class="profile-link">
                                <img src="/img/settings-1.svg" alt="">
                            </a>
                            <button type="button" class="menu-toggle menu-toggle--js">
                                <span></span><span></span>
                            </button>
                        </>
                    )
                }
            </div>
        </div>
    </div>
</header>

<script>
    import { logoutDirectusSession } from '../../../lib/directus';

    const logoutButton = document.querySelector<HTMLElement>('[data-directus-logout]');

    logoutButton?.addEventListener('click', async (event) => {
        event.preventDefault();

        if (logoutButton.getAttribute('aria-disabled') === 'true') {
            return;
        }

        logoutButton.setAttribute('aria-disabled', 'true');

        try {
            await logoutDirectusSession();
        } finally {
            window.location.replace('/');
        }
    });
</script>
